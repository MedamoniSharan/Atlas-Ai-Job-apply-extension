# Shared (all modes). Copy to `.env` for local secrets / Google client ID.
VITE_GOOGLE_CLIENT_ID=

# Browser store install links (Chrome is published):
VITE_CHROME_EXTENSION_URL=https://chromewebstore.google.com/detail/cosmo-job-assistant/gdapodjlojmapjdopfdnmhfhhlfamgkb
# Edge / Firefox still use store links when set:
VITE_EDGE_EXTENSION_URL=
VITE_FIREFOX_EXTENSION_URL=

VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# API pointing is mode-specific (committed files):
#   .env.development → http://localhost:4000
#   .env.production  → https://shjisr6492.execute-api.ap-south-2.amazonaws.com
#
# Override locally without editing those files:
#   .env.development.local / .env.production.local

# Extension packaging (npm run build --workspace=@cosmo/extension)
# Still writes client/public/cosmo-chrome-extension.zip for Web Store uploads.
# EXTENSION_API_ORIGIN=https://shjisr6492.execute-api.ap-south-2.amazonaws.com
# EXTENSION_WEB_ORIGIN=https://www.cosmovai.in,https://atlas-ai-job-apply-extension-client-roan.vercel.app
# EXTENSION_GECKO_ID=cosmo-job-assistant@cosmovai.com
# Firefox AMO package: npm run build:firefox --workspace=@cosmo/extension
# → writes ../cosmo-agent-firefox.zip (manifest.json at ZIP root)
