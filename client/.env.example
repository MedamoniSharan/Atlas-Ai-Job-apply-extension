# Shared (all modes). Copy to `.env` for local secrets / Google client ID.
VITE_GOOGLE_CLIENT_ID=

# Chrome installs via /cosmo-chrome-extension.zip (built by extension package).
# Edge / Firefox still use store links when set:
VITE_EDGE_EXTENSION_URL=
VITE_FIREFOX_EXTENSION_URL=

VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# API pointing is mode-specific (committed files):
#   .env.development → http://localhost:4000
#   .env.production  → https://atlas-ai-job-apply-extension-1.onrender.com
#
# Override locally without editing those files:
#   .env.development.local / .env.production.local

# Extension packaging (npm run build --workspace=@cosmo/extension)
# Writes client/public/cosmo-chrome-extension.zip for Chrome download CTAs.
# EXTENSION_API_ORIGIN=https://atlas-ai-job-apply-extension-1.onrender.com
# EXTENSION_WEB_ORIGIN=https://app.example.com
# EXTENSION_GECKO_ID=cosmo-job-assistant@cosmovai.com
