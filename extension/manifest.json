{
  "manifest_version": 3,
  "name": "Cosmo Job Assistant",
  "version": "1.0.0",
  "description": "Naukri job co-pilot — scan and assist Easy Apply from your preferences, synced to Cosmo",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://atlas-ai-job-apply-extension-1.onrender.com/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://www.naukri.com/*",
    "https://naukri.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cosmo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*", "https://naukri.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["webBridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://www.naukri.com/*", "https://naukri.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cosmo-job-assistant@cosmovai.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "personallyIdentifyingInfo",
          "websiteActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
